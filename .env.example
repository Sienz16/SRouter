# ==============================================================================
# SRouter Environment Configuration
# ==============================================================================

# API Gateway & Web Dashboard Port (Default: 3000)
PORT=3000

# OAuth Callback Listener Port (Default: 1455)
OAUTH_PORT=1455

# SQLite Database Location
# - For Local Dev: srouter.db (or apps/api/srouter.db)
# - For Docker: /app/data/srouter.db
DATABASE_PATH=srouter.db

# Path to built web dashboard static files (optional, defaults to apps/web/dist)
# WEB_DIST_PATH=apps/web/dist

# Node Environment (development | production)
NODE_ENV=development
